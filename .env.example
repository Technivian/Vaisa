# Which AI backend the chat route uses: "openai" or "gemini".
# Defaults to "gemini" in this demo if left blank.
AI_PROVIDER=

# --- OpenAI ---
# OpenAI API key (server-side only — never exposed to the browser)
OPENAI_API_KEY=

# Vector store ID for OpenAI File Search, created by `npm run upload-knowledge`
OPENAI_VECTOR_STORE_ID=

# Optional — defaults to gpt-4.1-mini if not set
OPENAI_MODEL=

# --- Gemini ---
# Gemini API key (server-side only — never exposed to the browser)
GEMINI_API_KEY=

# File Search store name for Gemini, created by `npm run upload-knowledge`
GEMINI_FILE_SEARCH_STORE_NAME=

# Optional — defaults to gemini-3.5-flash if not set
GEMINI_MODEL=
